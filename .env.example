# APP_URL: Primary public URL for Admin Panel
APP_URL="https://houseofmuktai.co.in"

# ALLOWED_ORIGINS: Comma-separated allowed HTTPS origins (root + www + staff subdomain)
ALLOWED_ORIGINS="https://houseofmuktai.co.in,https://www.houseofmuktai.co.in,https://staff.houseofmuktai.co.in"

# PORT: Listening port behind Nginx (default 3000)
PORT="3000"

# NODE_ENV: Set to "production" on live VPS servers to serve the compiled dist/ bundle
NODE_ENV="production"

# GEMINI_API_KEY: Server-side Google Gemini API key for Marathi Voice Assistant (Render/VPS/AI Studio Secrets)
GEMINI_API_KEY=

# ELEVENLABS_API_KEY: Optional server-side ElevenLabs key for ultra-natural Marathi speech (Eleven Multilingual v2)
ELEVENLABS_API_KEY=

# ELEVENLABS_VOICE_ID: Optional custom ElevenLabs voice ID (defaults to multilingual voice)
ELEVENLABS_VOICE_ID=

