# APP_URL: Primary public URL for Admin Panel
APP_URL="https://houseofmuktai.co.in"

# ALLOWED_ORIGINS: Comma-separated allowed HTTPS origins (root + www + staff subdomain)
ALLOWED_ORIGINS="https://houseofmuktai.co.in,https://www.houseofmuktai.co.in,https://staff.houseofmuktai.co.in"

# PORT: Listening port behind Nginx (default 3000)
PORT="3000"

# NODE_ENV: Set to "production" on live VPS servers to serve the compiled dist/ bundle
NODE_ENV="production"

# GEMINI_API_KEY: Server-side Google Gemini API key for Marathi Voice Assistant (Render/VPS/AI Studio Secrets)
GEMINI_API_KEY=

# ELEVENLABS_API_KEY: Server-side ElevenLabs Secret API key (starts with "sk_", NOT an API Key ID)
ELEVENLABS_API_KEY=

# ELEVENLABS_VOICE_ID: Your custom ElevenLabs Voice ID (copy from ElevenLabs Voices > ID)
ELEVENLABS_VOICE_ID=

# ELEVENLABS_MODEL_ID: Ultra-low-latency primary Marathi TTS model (defaults to "eleven_flash_v2_5", with same-voice fallback to eleven_v3 & eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# SARVAM_API_KEY: Server-side Sarvam AI Text-to-Speech API subscription key
SARVAM_API_KEY=

# SARVAM_MODEL_ID: Sarvam AI Marathi TTS model (defaults to "bulbul:v3" with speaker "mrunal")
SARVAM_MODEL_ID=bulbul:v3


