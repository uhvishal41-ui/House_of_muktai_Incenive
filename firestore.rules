        && isNonEmptyString(data.updatedAt, 40);
    }

    // Privacy-Hardened Leaderboard Entry: ONLY Rank, Full Name, Branch Name, Photo, Sale Amount (ZERO incentive fields or peer IDs)
    function isValidLeaderboardEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['rank', 'employeeName', 'branchName', 'saleAmtPaise'])
        && entry.keys().hasOnly(['rank', 'employeeName', 'branchName', 'photoDataUrl', 'saleAmtPaise'])
        && entry.rank is int && entry.rank >= 1 && entry.rank <= 3
        && isNonEmptyString(entry.employeeName, 120)
        && isNonEmptyString(entry.branchName, 120)
        && isOptionalString(entry, 'photoDataUrl', 45000)
        && entry.saleAmtPaise is int && entry.saleAmtPaise >= 0;
    }

    function isValidDepartmentLeaderboard(data) {
      return data.keys().hasAll([
          'leaderboardId', 'monthKey', 'departmentId', 'departmentName',
          'totalParticipants', 'top3', 'employeeVisible', 'updatedByEmail', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'leaderboardId', 'monthKey', 'departmentId', 'departmentName',
          'totalParticipants', 'top3', 'employeeVisible', 'updatedByEmail', 'updatedAt'
        ])
        && isValidId(data.leaderboardId)
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && isValidDepartmentId(data.departmentId)
        && isNonEmptyString(data.departmentName, 80)
        && data.totalParticipants is int && data.totalParticipants >= 0
        && data.top3 is list && data.top3.size() <= 3
        && (data.top3.size() < 1 || isValidLeaderboardEntry(data.top3[0]))
        && (data.top3.size() < 2 || isValidLeaderboardEntry(data.top3[1]))
        && (data.top3.size() < 3 || isValidLeaderboardEntry(data.top3[2]))
        && data.employeeVisible is bool
        && isNonEmptyString(data.updatedByEmail, 180)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidEmployeeDepartmentRank(data) {
      return data.keys().hasAll([
          'rankId', 'monthKey', 'employeeId', 'authUid', 'departmentId', 'departmentName',
          'rank', 'totalParticipants', 'saleAmtPaise', 'gapToTop3Paise', 'gapToRank1Paise',
          'employeeVisible', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'rankId', 'monthKey', 'employeeId', 'authUid', 'departmentId', 'departmentName',
          'rank', 'totalParticipants', 'saleAmtPaise', 'gapToTop3Paise', 'gapToRank1Paise',
          'employeeVisible', 'updatedAt'
        ])
        && isValidId(data.rankId)
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && isValidId(data.employeeId)
        && data.authUid is string && data.authUid.size() <= 128
        && isValidDepartmentId(data.departmentId)
        && isNonEmptyString(data.departmentName, 80)
        && data.rank is int && data.rank >= 0
        && data.totalParticipants is int && data.totalParticipants >= 0
        && data.saleAmtPaise is int && data.saleAmtPaise >= 0
        && data.gapToTop3Paise is int && data.gapToTop3Paise >= 0
        && data.gapToRank1Paise is int && data.gapToRank1Paise >= 0
        && data.employeeVisible is bool
        && isNonEmptyString(data.updatedAt, 40);
    }

    function sumSalaryEarningsA(data) {
      let da = data.get('dearnessAllowancePaise', 0);
      let att = data.get('attendanceAllowancePaise', 0);
      let wash = data.get('washingAllowancePaise', 0);
      let med = data.get('medicalAllowancePaise', 0);
      let lta = data.get('leaveTravelAllowancePaise', 0);
      let comm = data.get('communicationExpensesPaise', 0);
      return (data.basicPaise >= 0 && da >= 0 && data.hraPaise >= 0 && att >= 0 && wash >= 0
        && data.conveyancePaise >= 0 && med >= 0 && lta >= 0 && comm >= 0)
        ? (data.basicPaise + da + data.hraPaise + att + wash + data.conveyancePaise + med + lta + comm)
        : -1;
    }

    function isValidSalarySlipEarnings(data) {
      let sum1 = sumSalaryEarningsA(data);
      let hc = data.get('healthClubAllowancePaise', 0);
      let adhoc = data.get('adhocAllowancePaise', 0);
      let trav = data.get('travelingAllowancePaise', 0);
      let sc = data.get('salesCommissionPaise', 0);
      let arr = data.get('arrearsPaise', 0);
      let sum2 = hc + adhoc + trav + sc + data.specialAllowancePaise
        + data.overtimePaise + data.incentivePaise + arr + data.otherEarningsPaise;
      return sum1 >= 0 && hc >= 0 && adhoc >= 0 && trav >= 0 && sc >= 0
        && data.specialAllowancePaise >= 0 && data.overtimePaise >= 0
        && data.incentivePaise >= 0 && arr >= 0 && data.otherEarningsPaise >= 0
        && data.grossEarningsPaise is int
        && data.grossEarningsPaise == (sum1 + sum2);
    }

    function isValidSalarySlipDeductions(data) {
      let lwf = data.get('lwfPaise', 0);
      let pen = data.get('penaltyPaise', 0);
      let ins = data.get('insurancePaise', 0);
      let dedSum = data.pfPaise + data.esicPaise + data.ptPaise + lwf
        + data.advanceRecoveryPaise + data.tdsPaise + pen + ins + data.otherDeductionPaise;
      return data.pfPaise >= 0 && data.esicPaise >= 0 && data.ptPaise >= 0 && lwf >= 0
        && data.advanceRecoveryPaise >= 0 && data.tdsPaise >= 0 && pen >= 0 && ins >= 0
        && data.otherDeductionPaise >= 0
        && data.totalDeductionsPaise is int
        && data.totalDeductionsPaise == dedSum;
    }

    function isValidSalarySlipMetadata(data) {
      return isValidId(data.slipId)
        && isOptionalString(data, 'departmentName', 80)
        && isOptionalString(data, 'designation', 80)
        && isOptionalString(data, 'dateOfJoining', 20)
        && isOptionalString(data, 'panNumber', 20)
        && isOptionalString(data, 'uanNumber', 24)
        && isOptionalString(data, 'pfNumber', 32)
        && isOptionalString(data, 'esicNumber', 32)
        && isOptionalString(data, 'bankName', 80)
        && isOptionalString(data, 'bankAccountMasked', 32)
        && isOptionalString(data, 'bankIfsc', 20)
        && isOptionalString(data, 'paymentReference', 120)
        && isOptionalString(data, 'paymentDate', 30)
        && isOptionalString(data, 'remarks', 240);
    }

    function isValidSalarySlip(data) {
      let saleId = data.get('saleId', '');
      let gender = data.get('gender', '');
      let category = data.get('category', '');
      return data.keys().hasOnly([
          'slipId', 'monthKey', 'employeeId', 'saleId', 'authUid', 'employeeName', 'branchId', 'branchName',
          'departmentId', 'departmentName', 'designation', 'gender', 'category', 'dateOfJoining',
          'panNumber', 'uanNumber', 'pfNumber', 'esicNumber',
          'bankName', 'bankAccountMasked', 'bankIfsc',
          'totalDays', 'presentDays', 'paidDays', 'lopDays', 'weeklyOffDays', 'paidLeaveDays', 'overtimeDays', 'overtimeHours',
          'monthlySalaryRatePaise', 'monthlyGrossRatePaise',
          'basicPaise', 'dearnessAllowancePaise', 'hraPaise', 'attendanceAllowancePaise',
          'washingAllowancePaise', 'conveyancePaise', 'medicalAllowancePaise',
          'leaveTravelAllowancePaise', 'communicationExpensesPaise', 'healthClubAllowancePaise', 'adhocAllowancePaise',
          'travelingAllowancePaise', 'salesCommissionPaise', 'specialAllowancePaise',
          'overtimePaise', 'incentivePaise', 'arrearsPaise', 'otherEarningsPaise', 'grossEarningsPaise',
          'pfPaise', 'esicPaise', 'ptPaise', 'lwfPaise', 'advanceRecoveryPaise', 'tdsPaise',
          'penaltyPaise', 'insurancePaise', 'otherDeductionPaise', 'totalDeductionsPaise', 'netPayablePaise',
          'paymentMode', 'paymentReference', 'paymentDate', 'remarks',
          'employeeVisible', 'uploadedByEmail', 'uploadedAt', 'updatedAt'
        ])
        && isValidSalarySlipMetadata(data)
        && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && isValidId(data.employeeId)
        && saleId is string && saleId.size() <= 40
        && data.authUid is string && data.authUid.size() <= 128
        && data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 120
        && isValidId(data.branchId)
        && data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 120
        && data.get('departmentId', '') in ['', 'SAREE', 'LADIES_WEAR', 'KIDS_WEAR', 'MENS_WEAR', 'NON_APPARELS']
        && gender is string && gender.size() <= 20
        && category is string && category.size() <= 40
        && data.totalDays >= 0 && data.totalDays <= 31
        && data.get('presentDays', 0) >= 0
        && data.paidDays >= 0 && data.paidDays <= 31
        && data.lopDays >= 0 && data.weeklyOffDays >= 0 && data.paidLeaveDays >= 0
        && data.get('overtimeDays', 0) >= 0
        && data.overtimeHours >= 0
        && data.get('monthlySalaryRatePaise', 0) >= 0
        && data.get('monthlyGrossRatePaise', 0) >= 0
        && isValidSalarySlipEarnings(data)
        && isValidSalarySlipDeductions(data)
        && data.netPayablePaise is int
        && data.netPayablePaise == (data.grossEarningsPaise - data.totalDeductionsPaise)
        && data.get('paymentMode', '') in ['', 'BANK', 'NEFT', 'DCR', 'CASH', 'UPI', 'CHEQUE']
        && data.employeeVisible is bool
        && data.uploadedByEmail is string && data.uploadedByEmail.size() >= 1 && data.uploadedByEmail.size() <= 180
        && data.uploadedAt is string && data.uploadedAt.size() >= 1 && data.uploadedAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    // Privacy-Isolated 12-Branch Birthday Profile (STRICTLY MM-DD only; ZERO birth year, phone, PAN, bank, or salary fields)
    function isValidBirthdayProfile(data) {
      return data.keys().hasAll([
          'employeeId', 'fullName', 'branchId', 'branchName', 'designation',
          'birthMonthDay', 'birthMonth', 'birthDay', 'active', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'employeeId', 'fullName', 'branchId', 'branchName',
          'departmentId', 'departmentName', 'designation', 'photoDataUrl',
          'birthMonthDay', 'birthMonth', 'birthDay', 'active', 'updatedAt'
        ])
        && isValidId(data.employeeId)
        && isNonEmptyString(data.fullName, 120)
        && isValidId(data.branchId)
        && isNonEmptyString(data.branchName, 120)
        && isOptionalDepartmentId(data, 'departmentId')
        && isOptionalString(data, 'departmentName', 80)
        && isNonEmptyString(data.designation, 80)
        && isOptionalString(data, 'photoDataUrl', 45000)
        && isValidMonthDay(data.birthMonthDay)
        && data.birthMonth is int && data.birthMonth >= 1 && data.birthMonth <= 12
        && data.birthDay is int && data.birthDay >= 1 && data.birthDay <= 31
        && data.active is bool
        && isNonEmptyString(data.updatedAt, 40);
    }

    // Immutable Cross-Branch Birthday Wish (1 wish per sender per recipient per year)
    function isValidBirthdayWish(data) {
      return data.keys().hasAll([
          'wishId', 'celebrationYear', 'birthMonthDay',
          'recipientEmployeeId', 'recipientName', 'recipientBranchName',
          'senderEmployeeId', 'senderAuthUid', 'senderName', 'senderBranchName',
          'senderRole', 'message', 'createdAt'
        ])
        && data.keys().hasOnly([
          'wishId', 'celebrationYear', 'birthMonthDay',
          'recipientEmployeeId', 'recipientName', 'recipientBranchName',
          'senderEmployeeId', 'senderAuthUid', 'senderName', 'senderBranchName',
          'senderRole', 'message', 'createdAt'
        ])
        && isValidId(data.wishId)
        && data.celebrationYear is int && data.celebrationYear >= 2024 && data.celebrationYear <= 2100
        && isValidMonthDay(data.birthMonthDay)
        && isValidId(data.recipientEmployeeId)
        && isNonEmptyString(data.recipientName, 120)
        && isNonEmptyString(data.recipientBranchName, 120)
        && isValidId(data.senderEmployeeId)
        && isValidId(data.senderAuthUid)
        && isNonEmptyString(data.senderName, 120)
        && isNonEmptyString(data.senderBranchName, 120)
        && (data.senderRole == 'EMPLOYEE' || data.senderRole == 'SUPER_ADMIN')
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 240
        && isNonEmptyString(data.createdAt, 40);
    }

    function isValidEmployeeLoan(data) {
      return data.keys().hasAll([
          'loanId', 'employeeId', 'employeeName', 'branchId', 'branchName',
          'loanType', 'principalPaise', 'monthlyEmiPaise', 'totalInstallments',
          'paidInstallments', 'remainingBalancePaise', 'startMonthKey', 'status',
          'createdByEmail', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'loanId', 'employeeId', 'authUid', 'employeeName', 'branchId', 'branchName',
          'loanType', 'principalPaise', 'monthlyEmiPaise', 'totalInstallments',
          'paidInstallments', 'remainingBalancePaise', 'startMonthKey', 'lastDeductedMonthKey',
          'status', 'remarks', 'createdByEmail', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.loanId)
        && isValidId(data.employeeId)
        && isOptionalString(data, 'authUid', 128)
        && isNonEmptyString(data.employeeName, 120)
        && isValidId(data.branchId)
        && isNonEmptyString(data.branchName, 120)
        && (data.loanType == 'SALARY_ADVANCE' || data.loanType == 'PERSONAL_LOAN' || data.loanType == 'FESTIVAL_ADVANCE')
        && isNonNegInt(data.principalPaise) && data.principalPaise > 0 && data.principalPaise <= 1000000000
        && isNonNegInt(data.monthlyEmiPaise) && data.monthlyEmiPaise > 0 && data.monthlyEmiPaise <= data.principalPaise
        && isNonNegInt(data.totalInstallments) && data.totalInstallments >= 1 && data.totalInstallments <= 120
        && isNonNegInt(data.paidInstallments) && data.paidInstallments <= data.totalInstallments
        && isNonNegInt(data.remainingBalancePaise) && data.remainingBalancePaise <= data.principalPaise
        && isValidMonthKey(data.startMonthKey)
        && (!('lastDeductedMonthKey' in data) || data.lastDeductedMonthKey == '' || isValidMonthKey(data.lastDeductedMonthKey))
        && (data.status == 'ACTIVE' || data.status == 'CLOSED' || data.status == 'CANCELLED')
        && isOptionalString(data, 'remarks', 240)
        && isNonEmptyString(data.createdByEmail, 180)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    // Pillar 7 helper: Enforce active_auth_uids matches employee.status atomically when authUid is set
    function isActiveRegistrySyncedAfter(empData) {
      return !('authUid' in empData)
        || empData.authUid == ''
        || (
          empData.status == 'ACTIVE'
          && existsAfter(/databases/$(database)/documents/active_auth_uids/$(empData.authUid))
          && getAfter(/databases/$(database)/documents/active_auth_uids/$(empData.authUid)).data.active == true
        )
        || (
          empData.status == 'INACTIVE'
          && !existsAfter(/databases/$(database)/documents/active_auth_uids/$(empData.authUid))
        );
    }

    // Pillar 7 helper: Ensure rotated/removed previous authUid cannot remain orphaned in active_auth_uids
    function isPriorAuthUidCleanedUp(oldData, newData) {
      return !('authUid' in oldData)
        || oldData.authUid == ''
        || (('authUid' in newData) && newData.authUid == oldData.authUid)
        || !existsAfter(/databases/$(database)/documents/active_auth_uids/$(oldData.authUid));
    }

    // 1. Admins registry (MAIN OWNER ONLY manages admins; user may get own doc; active Password Admin may update own password timestamp)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (
        isMainOwner()
        || (isSignedIn() && request.auth.token.email_verified == true && request.auth.uid == adminUid)
        || (isSignedIn() && request.auth.uid == adminUid)
      );
      allow list: if isMainOwner();
      allow create: if isValidId(adminUid) && isMainOwner() && isValidAdminUser(incoming()) && incoming().uid == adminUid;
      allow update: if isValidId(adminUid) && isSignedIn() && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          (
            isMainOwner()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'username', 'role', 'authType', 'branchId',
              'active', 'mustChangePassword', 'passwordUpdatedAt', 'updatedAt'
            ])
          )
          || (
            request.auth.uid == adminUid
            && existing().active == true
            && existing().role == 'SUPER_ADMIN'
            && existing().authType == 'PASSWORD'
            && existing().email == request.auth.token.email
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().active == existing().active
            && incoming().authType == existing().authType
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'mustChangePassword', 'passwordUpdatedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(adminUid) && isMainOwner();
    }

    // 1b. Active Employee Auth UID Registry (Issue 1: Instant Firestore access revocation & department binding)
    match /active_auth_uids/{authUid} {
      allow get: if isValidId(authUid) && (
        isSuperAdmin() || (isSignedIn() && request.auth.uid == authUid)
      );
      allow list: if isSuperAdmin();
      allow create: if isValidId(authUid) && isSignedIn() && isValidActiveAuthUid(incoming())
        && incoming().authUid == authUid
        && (
          isSuperAdmin()
          || (
            request.auth.uid == authUid
            && incoming().active == true
            && existsAfter(/databases/$(database)/documents/employees/$(incoming().employeeId))
            && getAfter(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.authUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.status == 'ACTIVE'
            && (!('isBranchManager' in incoming()) || incoming().isBranchManager == getAfter(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.get('isBranchManager', false))
            && (!('branchId' in incoming()) || incoming().branchId == getAfter(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.branchId)
            && (!('branchName' in incoming()) || incoming().branchName == getAfter(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.branchName)
            && (!('departmentId' in incoming()) || incoming().departmentId == getAfter(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.get('departmentId', ''))
          )
        );
      allow update: if isValidId(authUid) && isSuperAdmin() && isValidActiveAuthUid(incoming())
        && incoming().authUid == authUid
        && (!('authUid' in existing()) || incoming().authUid == existing().authUid)
        && incoming().diff(existing()).addedKeys().hasOnly(['employeeId', 'departmentId', 'branchId', 'branchName', 'isBranchManager', 'active', 'updatedAt'])
        && incoming().diff(existing()).changedKeys().hasOnly(['employeeId', 'departmentId', 'branchId', 'branchName', 'isBranchManager', 'active', 'updatedAt']);
      allow delete: if isValidId(authUid) && isSuperAdmin();
    }

    // 2. Branch Master (Super Admin only)
    match /branches/{branchId} {
      allow get: if isValidId(branchId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(branchId) && isSuperAdmin() && isValidBranch(incoming()) && incoming().branchId == branchId;
      allow update: if isValidId(branchId) && isSuperAdmin() && isValidBranch(incoming())
        && incoming().branchId == existing().branchId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['branchCode', 'branchName', 'city', 'managerName', 'active', 'updatedAt']);
      allow delete: if isValidId(branchId) && isMainOwner();
    }

    // 3. Employee Master (PII Isolated; Active/Inactive status strictly SUPER ADMIN ONLY; Pillar 7 active_auth_uids sync)
    match /employees/{employeeId} {
      allow get: if isValidId(employeeId) && (
        isSuperAdmin()
        || (isSignedIn() && existing().authUid == request.auth.uid)
        || (isSignedIn() && request.auth.token.email_verified == true && 'linkedGoogleEmail' in existing() && existing().linkedGoogleEmail != '' && existing().linkedGoogleEmail == request.auth.token.email)
        || (isActiveBranchManager() && existing().branchId == activeBranchManagerBranchId())
      );
      allow list: if isSuperAdmin()
        || (isSignedIn() && resource.data.authUid == request.auth.uid)
        || (isSignedIn() && request.auth.token.email_verified == true && resource.data.linkedGoogleEmail == request.auth.token.email)
        || (isActiveBranchManager() && resource.data.branchId == activeBranchManagerBranchId());
      allow create: if isValidId(employeeId) && isSuperAdmin() && isValidEmployee(incoming())
        && incoming().employeeId == employeeId
        && isActiveRegistrySyncedAfter(incoming());
      allow update: if isValidId(employeeId) && isSignedIn()
        && (
          // Tier 1: Super Admin full governed update + atomic active_auth_uids sync
          (
            isSuperAdmin()
            && isValidEmployee(incoming())
            && incoming().employeeId == employeeId
            && (!('employeeId' in existing()) || incoming().employeeId == existing().employeeId)
            && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
            && incoming().diff(existing()).addedKeys().hasOnly([
              'saleId', 'loginId', 'authEmail', 'linkedGoogleEmail', 'authUid', 'fullName',
              'branchId', 'branchName', 'departmentId', 'departmentName', 'photoDataUrl',
              'designation', 'gender', 'category',
              'fatherOrSpouseName', 'maritalStatus', 'bloodGroup', 'qualification',
              'dateOfBirth', 'dateOfJoining', 'dateOfExit', 'exitReason',
              'employmentType', 'reportingManager', 'shiftTiming', 'weeklyOffDay', 'uniformSize',
              'aadhaarMasked', 'panNumber', 'uanNumber', 'pfNumber', 'esicNumber',
              'bankName', 'bankBranchName', 'bankAccountMasked', 'bankIfsc', 'upiId', 'paymentMode',
              'monthlyGrossSalaryPaise',
              'phone', 'alternatePhone', 'personalEmail', 'address', 'permanentAddress',
              'emergencyContactName', 'emergencyContact', 'nomineeName', 'nomineeRelation', 'hrRemarks',
              'customFields',
              'role', 'isBranchManager', 'status', 'mustChangePassword', 'credentialsProvisioned', 'createdAt', 'updatedAt'
            ])
            && incoming().diff(existing()).changedKeys().hasOnly([
              'saleId', 'loginId', 'authEmail', 'linkedGoogleEmail', 'authUid', 'fullName',
              'branchId', 'branchName', 'departmentId', 'departmentName', 'photoDataUrl',
              'designation', 'gender', 'category',
              'fatherOrSpouseName', 'maritalStatus', 'bloodGroup', 'qualification',
              'dateOfBirth', 'dateOfJoining', 'dateOfExit', 'exitReason',
              'employmentType', 'reportingManager', 'shiftTiming', 'weeklyOffDay', 'uniformSize',
              'aadhaarMasked', 'panNumber', 'uanNumber', 'pfNumber', 'esicNumber',
              'bankName', 'bankBranchName', 'bankAccountMasked', 'bankIfsc', 'upiId', 'paymentMode',
              'monthlyGrossSalaryPaise',
              'phone', 'alternatePhone', 'personalEmail', 'address', 'permanentAddress',
              'emergencyContactName', 'emergencyContact', 'nomineeName', 'nomineeRelation', 'hrRemarks',
              'customFields',
              'role', 'isBranchManager', 'status', 'mustChangePassword', 'credentialsProvisioned', 'updatedAt'
            ])
            && isActiveRegistrySyncedAfter(incoming())
            && isPriorAuthUidCleanedUp(existing(), incoming())
          )
          // Tier 2a: Active employee updating own permitted profile contact fields or clearing first-login password flag
          || isValidEmployeeSelfUpdate(existing(), incoming())
          // Tier 2b: One-time verified Google self-claim of empty authUid for ACTIVE employee (Issue 6)
          || isValidEmployeeGoogleSelfClaim(existing(), incoming())
        );
      allow delete: if isValidId(employeeId) && isMainOwner();
    }

    // 4. Staged & Published Excel Import Batches (SUPER ADMIN ONLY — Zero Employee Access; Audited Edit & Delete)
    match /import_batches/{batchId} {
      allow get: if isValidId(batchId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(batchId) && isSuperAdmin() && isValidImportBatch(incoming()) && incoming().batchId == batchId;
      allow update: if isValidId(batchId) && isSuperAdmin() && isValidImportBatch(incoming())
        && incoming().batchId == existing().batchId
        && incoming().fileSha256 == existing().fileSha256
        && incoming().createdAt == existing().createdAt
        && (
          // Action A: Non-terminal batch lifecycle transitions and staged edits
          (
            existing().status != 'PUBLISHED'
            && existing().status != 'REJECTED'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fileName', 'importType', 'periodStart', 'periodEnd', 'businessDate',
              'status', 'overlapResolutionMode', 'totalRows', 'validRows', 'errorRows', 'duplicateRows',
              'correctionRows', 'overlapRows', 'supersededRows', 'branchTransferRows',
              'totalIncentivePaise', 'totalSaleAmtPaise', 'totalSaleQty',
              'approvedByEmail', 'publishedByEmail',
              'publishLockId', 'publishStartedAt', 'publishAttemptCount', 'lastPublishError',
              'rejectionReason', 'correctionNote', 'updatedAt'
            ])
          )
          // Action B: Post-publish batch metadata & recomputed totals update (unlocked months for Super Admin; Main Owner always; status locked to PUBLISHED)
          || (
            (
              isMainOwner()
              || (
                isSuperAdmin()
                && existing().businessDate is string
                && existing().businessDate.size() >= 7
                && !isMonthPayrollLocked(existing().businessDate[0:7])
              )
            )
            && existing().status == 'PUBLISHED'
            && incoming().status == 'PUBLISHED'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fileName', 'totalRows', 'validRows', 'correctionRows',
              'totalIncentivePaise', 'totalSaleAmtPaise', 'totalSaleQty',
              'correctionNote', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(batchId) && (
        isMainOwner()
        || (isSuperAdmin() && existing().status != 'PUBLISHED')
      );
    }

    // 5. Staged & Published Excel Import Rows (SUPER ADMIN ONLY — Zero Employee Access)
    match /import_batch_rows/{rowId} {
      allow get: if isValidId(rowId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(rowId) && isSuperAdmin() && isValidImportBatchRow(incoming()) && incoming().rowId == rowId;
      allow update: if isValidId(rowId) && isSuperAdmin() && isValidImportBatchRow(incoming())
        && incoming().rowId == existing().rowId
        && incoming().batchId == existing().batchId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'importType', 'periodStart', 'periodEnd', 'businessDate',
          'employeeName', 'branchId', 'branchName',
          'component1Paise', 'component2Paise', 'component3Paise', 'totalPaise',
          'saleAmt1Paise', 'saleQty1', 'saleAmt2Paise', 'saleQty2', 'saleAmt3Paise', 'saleQty3',
          'totalSaleAmtPaise', 'totalSaleQty',
          'validationStatus', 'resolution', 'correctionReason', 'conflictingRecordIds', 'errorMessage'
        ]);
      allow delete: if isValidId(rowId) && isSuperAdmin();
    }

    // 6. Published Incentives (ACTIVE Employee Own OR Branch Manager Own Branch Read-Only + PUBLISHED + Visible Month)
    match /published_incentives/{recordId} {
      allow get: if isValidId(recordId) && (
        isSuperAdmin()
        || (isActiveEmployee() && existing().authUid == request.auth.uid && existing().status == 'PUBLISHED' && isEmployeeVisibleDoc(existing()))
        || (isActiveBranchManager() && existing().branchId == activeBranchManagerBranchId() && existing().status == 'PUBLISHED' && isEmployeeVisibleDoc(existing()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && resource.data.authUid == request.auth.uid && resource.data.status == 'PUBLISHED' && isEmployeeVisibleDoc(resource.data))
        || (isActiveBranchManager() && resource.data.branchId == activeBranchManagerBranchId() && resource.data.status == 'PUBLISHED' && isEmployeeVisibleDoc(resource.data));
      allow create: if isValidId(recordId) && isSuperAdmin() && isValidPublishedIncentive(incoming())
        && incoming().recordId == recordId
        && incoming().status == 'PUBLISHED'
        && !isMonthPayrollLocked(incoming().monthKey);
      allow update: if isValidId(recordId) && isSuperAdmin() && isValidPublishedIncentive(incoming())
        && incoming().recordId == existing().recordId
        && incoming().businessDate == existing().businessDate
        && incoming().employeeId == existing().employeeId
        && incoming().version >= existing().version
        && (!('importType' in existing()) || incoming().importType == existing().importType)
        && (!('periodStart' in existing()) || incoming().periodStart == existing().periodStart)
        && (!('periodEnd' in existing()) || incoming().periodEnd == existing().periodEnd)
        && (
          // Always allow non-financial visibility / authUid sync even on locked months
          incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'employeeVisible'])
          || (
            !isMonthPayrollLocked(existing().monthKey)
            && (
              // Active record correction, authUid backfill, visibility toggle, or soft-superseding during overlap reconciliation
              (
                existing().status == 'PUBLISHED'
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'authUid', 'employeeName', 'branchId', 'branchName',
                  'component1Label', 'component2Label', 'component3Label',
                  'component1Paise', 'component2Paise', 'component3Paise', 'totalPaise',
                  'saleAmt1Paise', 'saleQty1', 'saleAmt2Paise', 'saleQty2', 'saleAmt3Paise', 'saleQty3',
                  'totalSaleAmtPaise', 'totalSaleQty',
                  'status', 'version', 'batchId', 'correctionReason',
                  'supersededByBatchId', 'supersededByRecordId', 'supersededAt', 'supersededReason',
                  'employeeVisible', 'publishedAt', 'publishedByEmail'
                ])
              )
              // Already SUPERSEDED record: allow ONLY authUid backfill or visibility stamp
              || (
                existing().status == 'SUPERSEDED'
                && incoming().status == 'SUPERSEDED'
                && incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'employeeVisible'])
              )
            )
          )
        );
      allow delete: if isValidId(recordId) && isMainOwner() && !isMonthPayrollLocked(existing().monthKey);
    }

    // 7. Immutable Correction Version History (SUPER ADMIN ONLY — Append-Only)
    match /incentive_versions/{versionId} {
      allow get: if isValidId(versionId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(versionId) && isSuperAdmin() && isValidIncentiveVersion(incoming()) && incoming().versionId == versionId;
      allow update: if false;
      allow delete: if isValidId(versionId) && isMainOwner();
    }

    // 8. Pre-Aggregated Monthly Summaries (Super Admin OR Active Employee Own OR Branch Manager Own Branch Read-Only + Visible Month)
    match /monthly_summaries/{summaryId} {
      allow get: if isValidId(summaryId) && (
        isSuperAdmin()
        || (isActiveEmployee() && existing().authUid == request.auth.uid && isEmployeeVisibleDoc(existing()))
        || (isActiveBranchManager() && existing().branchId == activeBranchManagerBranchId() && isEmployeeVisibleDoc(existing()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && resource.data.authUid == request.auth.uid && isEmployeeVisibleDoc(resource.data))
        || (isActiveBranchManager() && resource.data.branchId == activeBranchManagerBranchId() && isEmployeeVisibleDoc(resource.data));
      allow create: if isValidId(summaryId) && isSuperAdmin() && isValidMonthlySummary(incoming())
        && incoming().summaryId == summaryId
        && !isMonthPayrollLocked(incoming().monthKey);
      allow update: if isValidId(summaryId) && isSuperAdmin() && isValidMonthlySummary(incoming())
        && incoming().summaryId == existing().summaryId
        && incoming().employeeId == existing().employeeId
        && incoming().monthKey == existing().monthKey
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'employeeVisible'])
          || (
            !isMonthPayrollLocked(existing().monthKey)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authUid', 'employeeName', 'branchId', 'branchName', 'sourceType',
              'component1TotalPaise', 'component2TotalPaise', 'component3TotalPaise',
              'grandTotalPaise',
              'saleAmt1TotalPaise', 'saleQty1Total', 'saleAmt2TotalPaise', 'saleQty2Total',
              'saleAmt3TotalPaise', 'saleQty3Total', 'totalSaleAmtPaise', 'totalSaleQty',
              'publishedDaysCount', 'employeeVisible', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(summaryId) && isMainOwner() && !isMonthPayrollLocked(existing().monthKey);
    }

    // 9. Append-Only Audit Logs (SUPER ADMIN ONLY — Never deletable)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(logId) && isSuperAdmin() && isValidAuditLog(incoming()) && incoming().logId == logId;
      allow update, delete: if false;
    }

    // 10. Employee Publish Notifications (Active Employee Own Auth UID Only; Super Admin backfill & rollback cleanup)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isSuperAdmin() || (isActiveEmployee() && existing().authUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isActiveEmployee() && resource.data.authUid == request.auth.uid);
      allow create: if isValidId(notificationId) && isSuperAdmin() && isValidNotification(incoming()) && incoming().notificationId == notificationId;
      allow update: if isValidId(notificationId) && isSignedIn()
        && (
          (
            isSuperAdmin()
            && isValidNotification(incoming())
            && incoming().notificationId == existing().notificationId
            && incoming().employeeId == existing().employeeId
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'read', 'readAt'])
          )
          || isValidNotificationReadUpdate(existing(), incoming())
        );
      allow delete: if isValidId(notificationId) && isSuperAdmin();
    }

    // 11. Monthly Payout Settlement Records (Super Admin writes; Active Employee reads own + visible month)
    match /payout_records/{payoutId} {
      allow get: if isValidId(payoutId) && (
        isSuperAdmin()
        || (isActiveEmployee() && isEmployeeVisibleDoc(existing()) && (existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && isEmployeeVisibleDoc(resource.data) && (resource.data.authUid == request.auth.uid || resource.data.employeeId == activeEmployeeId()));
      allow create: if isValidId(payoutId) && isSuperAdmin() && isValidPayoutRecord(incoming())
        && incoming().payoutId == payoutId
        && !isMonthPayrollLocked(incoming().monthKey);
      allow update: if isValidId(payoutId) && isSuperAdmin() && isValidPayoutRecord(incoming())
        && incoming().payoutId == existing().payoutId
        && incoming().employeeId == existing().employeeId
        && incoming().monthKey == existing().monthKey
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'employeeVisible'])
          || (
            !isMonthPayrollLocked(existing().monthKey)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'authUid', 'employeeName', 'branchId', 'branchName',
              'grossIncentivePaise', 'adjustmentsNetPaise', 'netPayablePaise',
              'status', 'paymentMode', 'paymentReference', 'paidAt', 'remarks',
              'employeeVisible', 'updatedByEmail', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(payoutId) && isSuperAdmin() && !isMonthPayrollLocked(existing().monthKey);
    }

    // 12. Audited Bonus / Deduction / Advance Adjustments (Super Admin writes; Active Employee reads own ACTIVE + visible month)
    match /incentive_adjustments/{adjustmentId} {
      allow get: if isValidId(adjustmentId) && (
        isSuperAdmin()
        || (isActiveEmployee() && existing().status == 'ACTIVE' && isEmployeeVisibleDoc(existing()) && (existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && resource.data.status == 'ACTIVE' && isEmployeeVisibleDoc(resource.data) && (resource.data.authUid == request.auth.uid || resource.data.employeeId == activeEmployeeId()));
      allow create: if isValidId(adjustmentId) && isSuperAdmin() && isValidIncentiveAdjustment(incoming())
        && incoming().adjustmentId == adjustmentId
        && incoming().status == 'ACTIVE'
        && !isMonthPayrollLocked(incoming().monthKey);
      allow update: if isValidId(adjustmentId) && isSuperAdmin() && isValidIncentiveAdjustment(incoming())
        && incoming().adjustmentId == existing().adjustmentId
        && incoming().employeeId == existing().employeeId
        && incoming().monthKey == existing().monthKey
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'employeeVisible'])
          || (
            !isMonthPayrollLocked(existing().monthKey)
            && incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'status', 'voidedByEmail', 'voidedAt', 'employeeVisible'])
          )
        );
      allow delete: if isValidId(adjustmentId) && isSuperAdmin() && !isMonthPayrollLocked(existing().monthKey);
    }

    // 13. Monthly Sales Targets (Super Admin writes; Active Employee reads own/branch + Branch Manager own branch + visible month)
    match /sales_targets/{targetId} {
      allow get: if isValidId(targetId) && (
        isSuperAdmin()
        || (isActiveEmployee() && isEmployeeVisibleDoc(existing()) && (existing().scope == 'BRANCH' || existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId()))
        || (isActiveBranchManager() && isEmployeeVisibleDoc(existing()) && existing().branchId == activeBranchManagerBranchId())
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && isEmployeeVisibleDoc(resource.data) && (resource.data.scope == 'BRANCH' || resource.data.authUid == request.auth.uid || resource.data.employeeId == activeEmployeeId()))
        || (isActiveBranchManager() && isEmployeeVisibleDoc(resource.data) && resource.data.branchId == activeBranchManagerBranchId());
      allow create: if isValidId(targetId) && isSuperAdmin() && isValidSalesTarget(incoming()) && incoming().targetId == targetId;
      allow update: if isValidId(targetId) && isSuperAdmin() && isValidSalesTarget(incoming())
        && incoming().targetId == existing().targetId
        && incoming().monthKey == existing().monthKey
        && incoming().scope == existing().scope
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'branchId', 'branchName', 'employeeId', 'authUid', 'employeeName',
          'targetSaleAmtPaise', 'targetSaleQty', 'employeeVisible', 'updatedByEmail', 'updatedAt'
        ]);
      allow delete: if isValidId(targetId) && isSuperAdmin();
    }

    // 14. Employee Query / Dispute Tickets (Active Employee creates & reads own; Super Admin resolves or syncs authUid on password reset)
    match /employee_queries/{queryId} {
      allow get: if isValidId(queryId) && (
        isSuperAdmin()
        || (isActiveEmployee() && (existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && (resource.data.authUid == request.auth.uid || resource.data.employeeId == activeEmployeeId()));
      allow create: if isValidId(queryId) && isActiveEmployee() && isValidEmployeeQuery(incoming())
        && incoming().queryId == queryId
        && incoming().authUid == request.auth.uid
        && incoming().employeeId == activeEmployeeId()
        && incoming().status == 'OPEN'
        && !('adminReply' in incoming())
        && !('resolvedByEmail' in incoming());
      allow update: if isValidId(queryId) && isSuperAdmin() && isValidEmployeeQuery(incoming())
        && incoming().queryId == existing().queryId
        && incoming().employeeId == existing().employeeId
        && incoming().createdAt == existing().createdAt
        && (
          (
            incoming().authUid == existing().authUid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'resolvedByEmail', 'updatedAt'])
          )
          || incoming().diff(existing()).affectedKeys().hasOnly(['authUid'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'updatedAt'])
        );
      allow delete: if isValidId(queryId) && isSuperAdmin();
    }

    // 15. Portal Settings (visibility: Admin write, Active Employees read; employee_columns: Admin-only; payroll_locks: Main Owner write, Admin read)
    match /portal_settings/{settingId} {
      allow get: if (settingId == 'visibility' && (isSuperAdmin() || isActiveEmployee()))
        || (settingId == 'employee_columns' && isSuperAdmin())
        || (settingId == 'payroll_locks' && isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if (
        isSuperAdmin() && (
          (settingId == 'visibility' && isValidPortalVisibilitySettings(incoming()))
          || (settingId == 'employee_columns' && isValidEmployeeColumnSettings(incoming()))
        )
      ) || (
        settingId == 'payroll_locks' && isMainOwner() && isValidPayrollLockSettings(incoming())
      );
      allow update: if (
        isSuperAdmin() && (
          (
            settingId == 'visibility'
            && isValidPortalVisibilitySettings(incoming())
            && incoming().settingId == existing().settingId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'mode', 'visibleMonths', 'salarySlipMode', 'salarySlipVisibleMonths', 'updatedByEmail', 'updatedAt'
            ])
          )
          || (
            settingId == 'employee_columns'
            && isValidEmployeeColumnSettings(incoming())
            && incoming().settingId == existing().settingId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'customColumns', 'visibleColumns', 'updatedByEmail', 'updatedAt'
            ])
          )
        )
      ) || (
        settingId == 'payroll_locks'
        && isMainOwner()
        && isValidPayrollLockSettings(incoming())
        && incoming().settingId == existing().settingId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lockedMonths', 'lockNote', 'updatedByEmail', 'updatedAt'
        ])
      );
      allow delete: if false;
    }

    // 16. Cross-Branch Department Top-3 Sales Leaderboards (Privacy-Hardened: Active Employee reads OWN Dept + Visible Month ONLY; zero list)
    match /department_leaderboards/{leaderboardId} {
      allow get: if isValidId(leaderboardId) && (
        isSuperAdmin()
        || (
          isActiveEmployee()
          && hasActiveEmployeeDepartment()
          && (
            (
              resource == null
              && leaderboardId.matches('^[0-9]{4}-[0-9]{2}__' + activeEmployeeDepartmentId() + '$')
            )
            || (
              resource != null
              && existing().employeeVisible == true
              && isEmployeeVisibleDoc(existing())
              && existing().departmentId == activeEmployeeDepartmentId()
            )
          )
        )
      );
      allow list: if isSuperAdmin();
      allow create: if isValidId(leaderboardId) && isSuperAdmin() && isValidDepartmentLeaderboard(incoming())
        && incoming().leaderboardId == leaderboardId;
      allow update: if isValidId(leaderboardId) && isSuperAdmin() && isValidDepartmentLeaderboard(incoming())
        && incoming().leaderboardId == existing().leaderboardId
        && incoming().monthKey == existing().monthKey
        && incoming().departmentId == existing().departmentId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'departmentName', 'totalParticipants', 'top3', 'employeeVisible', 'updatedByEmail', 'updatedAt'
        ]);
      allow delete: if isValidId(leaderboardId) && isSuperAdmin();
    }

    // 17. Private Employee Department Ranks (Active Employee reads OWN rank doc + Visible Month ONLY; zero list)
    match /employee_department_ranks/{rankId} {
      allow get: if isValidId(rankId) && (
        isSuperAdmin()
        || (
          isActiveEmployee()
          && (
            (
              resource == null
              && rankId.matches('^[0-9]{4}-[0-9]{2}__' + activeEmployeeId() + '$')
            )
            || (
              resource != null
              && existing().employeeVisible == true
              && isEmployeeVisibleDoc(existing())
              && (existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId())
            )
          )
        )
      );
      allow list: if isSuperAdmin();
      allow create: if isValidId(rankId) && isSuperAdmin() && isValidEmployeeDepartmentRank(incoming())
        && incoming().rankId == rankId;
      allow update: if isValidId(rankId) && isSuperAdmin() && isValidEmployeeDepartmentRank(incoming())
        && incoming().rankId == existing().rankId
        && incoming().monthKey == existing().monthKey
        && incoming().employeeId == existing().employeeId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authUid', 'departmentId', 'departmentName', 'rank', 'totalParticipants',
          'saleAmtPaise', 'gapToTop3Paise', 'gapToRank1Paise', 'employeeVisible', 'updatedAt'
        ]);
      allow delete: if isValidId(rankId) && isSuperAdmin();
    }

    // 18. Private Monthly Employee Salary Slips (Super Admin writes; Active Employee reads STRICTLY own visible slips)
    match /salary_slips/{slipId} {
      allow get: if isValidId(slipId) && (
        isSuperAdmin()
        || (isActiveEmployee() && isSalarySlipVisibleDoc(existing()) && (existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && isSalarySlipVisibleDoc(resource.data) && (resource.data.authUid == request.auth.uid || resource.data.employeeId == activeEmployeeId()));
      allow create: if isValidId(slipId) && isSuperAdmin() && isValidSalarySlip(incoming())
        && incoming().slipId == slipId
        && !isMonthPayrollLocked(incoming().monthKey);
      allow update: if isValidId(slipId) && isSuperAdmin() && isValidSalarySlip(incoming())
        && incoming().slipId == existing().slipId
        && incoming().monthKey == existing().monthKey
        && incoming().employeeId == existing().employeeId
        && (!('uploadedAt' in existing()) || incoming().uploadedAt == existing().uploadedAt)
        && (
          !isMonthPayrollLocked(existing().monthKey)
          || incoming().diff(existing()).affectedKeys().hasOnly(['authUid', 'employeeVisible', 'updatedAt'])
        );
      allow delete: if isValidId(slipId) && isSuperAdmin() && !isMonthPayrollLocked(existing().monthKey);
    }

    // 19. Privacy-Isolated 12-Branch Birthday Directory (Super Admin writes; Active Employees read active celebration profiles with ZERO PII)
    match /birthday_profiles/{employeeId} {
      allow get: if isValidId(employeeId) && (
        isSuperAdmin()
        || (isActiveEmployee() && existing().active == true)
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && resource.data.active == true);
      allow create: if isValidId(employeeId) && isSuperAdmin() && isValidBirthdayProfile(incoming())
        && incoming().employeeId == employeeId;
      allow update: if isValidId(employeeId) && isSuperAdmin() && isValidBirthdayProfile(incoming())
        && incoming().employeeId == employeeId
        && (!('employeeId' in existing()) || incoming().employeeId == existing().employeeId)
        && incoming().diff(existing()).addedKeys().hasOnly([
          'fullName', 'branchId', 'branchName', 'departmentId', 'departmentName',
          'designation', 'photoDataUrl', 'birthMonthDay', 'birthMonth', 'birthDay',
          'active', 'updatedAt'
        ])
        && incoming().diff(existing()).changedKeys().hasOnly([
          'fullName', 'branchId', 'branchName', 'departmentId', 'departmentName',
          'designation', 'photoDataUrl', 'birthMonthDay', 'birthMonth', 'birthDay',
          'active', 'updatedAt'
        ]);
      allow delete: if isValidId(employeeId) && isSuperAdmin();
    }

    // 20. Cross-Branch Birthday Wishes (Immutable; 1 wish per sender per recipient per year; Active Employees read wishes received OR sent by self)
    match /birthday_wishes/{wishId} {
      allow get: if isValidId(wishId) && (
        isSuperAdmin()
        || (isActiveEmployee() && (existing().recipientEmployeeId == activeEmployeeId() || existing().senderAuthUid == request.auth.uid))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && (resource.data.recipientEmployeeId == activeEmployeeId() || resource.data.senderAuthUid == request.auth.uid));
      allow create: if isValidId(wishId)
        && isSignedIn()
        && isValidBirthdayWish(incoming())
        && incoming().wishId == wishId
        && incoming().senderAuthUid == request.auth.uid
        && exists(/databases/$(database)/documents/birthday_profiles/$(incoming().recipientEmployeeId))
        && get(/databases/$(database)/documents/birthday_profiles/$(incoming().recipientEmployeeId)).data.active == true
        && get(/databases/$(database)/documents/birthday_profiles/$(incoming().recipientEmployeeId)).data.birthMonthDay == incoming().birthMonthDay
        && (
          (
            isSuperAdmin()
            && incoming().senderRole == 'SUPER_ADMIN'
          )
          || (
            isActiveEmployee()
            && incoming().senderRole == 'EMPLOYEE'
            && incoming().senderEmployeeId == activeEmployeeId()
            && incoming().recipientEmployeeId != activeEmployeeId()
            && wishId == (string(incoming().celebrationYear) + '__' + incoming().recipientEmployeeId + '__' + activeEmployeeId())
          )
        );
      allow update: if false;
      allow delete: if isValidId(wishId) && isSuperAdmin();
    }

    // 21. Employee Advances & Loans EMI Tracker (Super Admin writes; Active Employee reads strictly own loans)
    match /employee_loans/{loanId} {
      allow get: if isValidId(loanId) && (
        isSuperAdmin()
        || (isActiveEmployee() && (existing().authUid == request.auth.uid || existing().employeeId == activeEmployeeId()))
      );
      allow list: if isSuperAdmin()
        || (isActiveEmployee() && (resource.data.authUid == request.auth.uid || resource.data.employeeId == activeEmployeeId()));
      allow create: if isValidId(loanId) && isSuperAdmin() && isValidEmployeeLoan(incoming())
        && incoming().loanId == loanId;
      allow update: if isValidId(loanId) && isSuperAdmin() && isValidEmployeeLoan(incoming())
        && incoming().loanId == existing().loanId
        && incoming().employeeId == existing().employeeId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authUid', 'employeeName', 'branchId', 'branchName',
          'monthlyEmiPaise', 'totalInstallments', 'paidInstallments',
          'remainingBalancePaise', 'lastDeductedMonthKey', 'status', 'remarks', 'updatedAt'
        ]);
      allow delete: if isValidId(loanId) && isSuperAdmin();
    }
  }
}
