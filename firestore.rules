    function isValidNotificationReadUpdate(oldData, newData) {
      return isActiveEmployee()
        && oldData.authUid == request.auth.uid
        && newData.notificationId == oldData.notificationId
        && newData.employeeId == oldData.employeeId
        && newData.authUid == oldData.authUid
        && (!('createdAt' in oldData) || newData.createdAt == oldData.createdAt)
        && newData.diff(oldData).affectedKeys().hasOnly(['read', 'readAt'])
        && newData.read is bool
        && isOptionalString(newData, 'readAt', 40);
    }

    function isValidPayoutRecord(data) {
      return data.keys().hasAll([
          'payoutId', 'monthKey', 'employeeId', 'authUid', 'employeeName',
