    function isValidEmployeeColumnSettings(data) {
      return data.keys().hasAll(['settingId', 'customColumns', 'visibleColumns', 'updatedByEmail', 'updatedAt'])
        && data.keys().hasOnly(['settingId', 'customColumns', 'visibleColumns', 'updatedByEmail', 'updatedAt'])
