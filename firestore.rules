    function isValidPortalVisibilitySettings(data) {
      return data.keys().hasAll(['settingId', 'mode', 'visibleMonths', 'updatedByEmail', 'updatedAt'])
        && data.keys().hasOnly([
          'settingId', 'mode', 'visibleMonths', 'salarySlipMode', 'salarySlipVisibleMonths', 'updatedByEmail', 'updatedAt'
        ])
        && data.settingId == 'visibility'
        && (data.mode == 'ALL' || data.mode == 'SELECTED')
        && data.visibleMonths is list
        && data.visibleMonths.size() <= 48
        && (
          data.visibleMonths.size() == 0
          || (data.visibleMonths[0] is string && data.visibleMonths[0].size() == 7 && data.visibleMonths[0].matches('^[0-9]{4}-[0-9]{2}$'))
        )
        && (
          !('salarySlipMode' in data)
          || data.salarySlipMode == 'ALL'
          || data.salarySlipMode == 'SELECTED'
        )
        && (
          !('salarySlipVisibleMonths' in data)
          || (
