    function isValidPayrollLockSettings(data) {
      return data.keys().hasAll(['settingId', 'lockedMonths', 'updatedByEmail', 'updatedAt'])
        && data.keys().hasOnly(['settingId', 'lockedMonths', 'lockNote', 'updatedByEmail', 'updatedAt'])
